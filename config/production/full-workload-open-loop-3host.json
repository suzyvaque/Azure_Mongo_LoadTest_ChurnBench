{
  // PRODUCTION config — 3-HOST open-loop burst, sized to REACH ≈11,000 concurrent / ≥1,210 conn/s using
  // the three co-located AZ1 generators (vm-hpc-loadgen-az1-0/1/2) for BOTH mongo-shard and documentdb
  // (runs are sequential, so both targets share the same 3-host pool), WITHOUT exceeding any single
  // host's ephemeral-port churn ceiling (~55,534 ports / 30 s TIME_WAIT ≈ 1,850 conn/s per host).
  //
  //   Run each host with:  --host-id N --host-count 3 --run-tag <campaign> --start-at <UTC>
  //   Then aggregate with: report merge --input results --tag <campaign>
  //
  // SIZING MATH (3 hosts):
  //   * Offered conn/s per host  ≈ λ × mean(MinTasksPerJob..MaxTasksPerJob) = 4.0 × mean(150..500=325)
  //                              ≈ 1,300 conn/s/host  (< 1,850 ceiling → NO client meltdown, ~70% load).
  //   * Combined offered conn/s  ≈ 3 × 1,300 = 3,900 conn/s   (≫ the ≥1,210 conn/s requirement).
  //   * Concurrency ≈ combined conn/s × per-Task hold. Hold = TaskSleepMs (2.9 s) + ~0.1 s op ≈ 3.0 s.
  //                  3,900 × 3.0 ≈ 11,700 concurrent  (≥ 11,000 requirement, with headroom).
  //   NOTE: the multihost base pins λ=6.0/host (≈1,950 conn/s/host) which EXCEEDS the ~1,850 per-host
  //   ceiling and only stays safe when the load is spread thinner. With three hosts we lower λ to 4.0 so
  //   each host churns well under its ceiling while the combined peak still clears the envelope. Verify
  //   the ACTUAL peak with `report merge`.
  "Extends": "full-workload-open-loop-multihost.json",

  // Hold so 3 hosts sustain ≈11,700 concurrent at a safe ~3,900 conn/s combined (see math above).
  "TaskSleepMs": 2900,

  "Scenario": {
    "Burst": {
      "Enabled": true,
      "OpenLoop": true,

      // Per-host arrival rate kept so each host offers ≈1,300 conn/s (< 1,850 ceiling).
      "JobsPerSecondLambda": 4.0,

      "MinTasksPerJob": 150,
      "MaxTasksPerJob": 500
    }
  }
}
