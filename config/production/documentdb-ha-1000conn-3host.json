{
  // Three synchronized generators, each offering 333.333333 single-use clients/s:
  //   3 * 333.333333 = 1,000 new connection lifecycles/s combined.
  // This follows the prior production-rate mostly-idle shape: a full four-operation Task keeps its
  // fresh connection resident for 3.5 seconds. A healthy backend should therefore hold roughly
  // 1,000/s * 3.5s = 3,500 mostly-idle live connections. This is a rate/residence test, not the
  // separate fixed-population 12,000-connection hold test.
  "Extends": "documentdb-ha-full-workload.json",

  "TaskSleepMs": 3500,

  "Workload": {
    "Mode": "FullWorkload",
    "SingleOpType": "FindInput"
  },

  "Scenario": {
    "IterationDurationSeconds": 600,
    "MaxConcurrentTasks": 30000,
    "Steady": {
      "Enabled": true,
      "TasksPerSecond": 333.3333333333
    },
    "Burst": {
      "Enabled": false,
      "OpenLoop": false
    }
  }
}