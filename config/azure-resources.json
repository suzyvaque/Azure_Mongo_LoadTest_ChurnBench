{
  // ============================================================================================
  // Azure resource identifiers for POST-RUN metric pulls (server-side capture, handoff Package B5).
  // Identifiers ONLY — NO secrets. Connection strings stay in BMT_CONN* env vars.
  //
  // Consumed by scripts/run/Get-AzureMetrics.ps1 (invoked from Invoke-LocalCampaign.ps1 and after a
  // multi-host Invoke-Campaign.ps1 run). The pull is a clean NO-OP when `az` is not logged in or when
  // the fields below are left empty, so the runner stays usable without any Azure dependency.
  // ============================================================================================

  "Subscription": "01c04f52-ad2b-4cc0-b77b-61508ec58f51",
  "ResourceGroup": "rg-db-test-hpc",

  // DocumentDB (PaaS) — Azure Cosmos DB for MongoDB vCore cluster.
  // Full published metric set (verified via `az monitor metrics list-definitions`, retention 93d,
  // grains PT1M..P1D): CpuPercent, MemoryPercent, CommittedMemoryPercent, AutoscaleUtilizationPercent,
  // StoragePercent, StorageUsed, IOPS, NetworkBytesIngress/Egress, MongoRequestDurationMs.
  // MongoRequestDurationMs is a Latency metric with a Count aggregation (= requests served → server-side
  // RPS) and rich dimensions (Operation, StatusCode, StatusCodeClass, ErrorCode, DatabaseName,
  // CollectionName, ...). There is NO dedicated active-connection counter, but the request Count gives
  // server-side throughput and the StatusCodeClass dimension surfaces 4xx/5xx (throttles/errors).
  // Concurrent/created connection counts for docdb still come from the client-side merged concurrency.
  // ACTIVE TARGET this round: docdb-dbtest-hpc-1 (M80/M200 tier sweep, no autoscale). Reconfigured to
  // the fixed spec — 2 physical shards (hashed ReqId key, empty-first-reshard + reseed, 33/32 chunk
  // split verified), HA enabled (ZoneRedundantPreferred), private-only (publicNetworkAccess Disabled,
  // reachable via pe-docdb-hpc1-vcore in vm-dbtest-hpc-0-vnet). Update Tier below to match the current
  // resize before each campaign / metric pull. docdb-dbtest-hpc-0 identifiers are further below (kept,
  // not currently targeted).
  "DocumentDb": {
    "ClusterName": "docdb-dbtest-hpc-1",
    "Tier": "M80",
    "MetricsResourceId": "/subscriptions/01c04f52-ad2b-4cc0-b77b-61508ec58f51/resourceGroups/rg-db-test-hpc/providers/Microsoft.DocumentDB/mongoClusters/docdb-dbtest-hpc-1"
  },

  // Previous round's target (docdb-dbtest-hpc-0) — kept for reference / future re-use.
  "DocumentDbHpc0": {
    "ClusterName": "docdb-dbtest-hpc-0",
    "Tier": "M30",
    "MetricsResourceId": "/subscriptions/01c04f52-ad2b-4cc0-b77b-61508ec58f51/resourceGroups/rg-db-test-hpc/providers/Microsoft.DocumentDB/mongoClusters/docdb-dbtest-hpc-0"
  },

  // Cosmos DB for MongoDB (RU) account (out of scope for server RU capture this round; identifiers kept).
  "CosmosRu": {
    "AccountName": "",
    "Region": "koreacentral",
    "MetricsResourceId": ""
  },

  // Self-managed MongoDB on Azure VMs. Used for VM host metrics (CPU/mem/net via Azure Monitor) and
  // for locating the mongod.log slice per target. serverStatus/connPoolStats come from the bmt_monitor
  // user (BMT_CONN_MONGO_MONITOR), not from these identifiers.
  //
  // NOTE: mongo-vm (rs0 on vm-dbtest-hpc-1-mongo) is DROPPED as a campaign target this round — its
  // mongod is shard-1 of the sharded cluster, so it is not an independent dataset. Identifiers kept
  // for completeness / future single-node work.
  "MongoVm": {
    "ActiveVmName": "vm-dbtest-hpc-1-mongo",
    "MongodLogPath": "E:\\mongo\\log\\mongod.log"
  },
  "MongoShard": {
    // mongos routers: 10.3.0.4:27016 (on -mongo) and 10.3.0.6:27017 (on -mongo-shard).
    "MongosVmNames": [ "vm-dbtest-hpc-1-mongo", "vm-dbtest-hpc-1-mongo-shard" ],
    // shards: rs0 (on -mongo) + rsShard2 (on -mongo-shard).
    "ShardVmNames": [ "vm-dbtest-hpc-1-mongo", "vm-dbtest-hpc-1-mongo-shard" ],
    // Client connection churn lands on the mongos routers, so the mongos.log is the relevant slice
    // (present on BOTH router VMs). mongod.log/shard2.log hold intra-cluster connections only.
    "MongosLogPath": "E:\\mongo\\log\\mongos.log"
  }
}
