<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bmt.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <!-- Used only to resolve DocumentDB's mongodb+srv SRV record ONCE per cache refresh (see
         TaskConnectionFactory's SRV-storm mitigation) instead of per-Task; same package/version
         Bmt.LoadGen already uses for TargetEndpointResolver. -->
    <PackageReference Include="DnsClient" Version="1.6.1" />
  </ItemGroup>

</Project>
